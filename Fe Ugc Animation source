-- GRID RENDERING
-- ─────────────────────────────────────────────
local searchResults = {}
local catalogCursor = nil
local currentPageIndex = 1
local itemsPerPage = 9

local function clearActiveGridContext()
	for _, thread in ipairs(activeGridThreads) do task.cancel(thread) end
	activeGridThreads = {}
	for _, child in ipairs(gridScroller:GetChildren()) do
		if child:IsA("ViewportFrame") then child:Destroy() end
	end
end

local function drawGridPage()
	clearActiveGridContext()
	loadingOverlay.Visible = false

	local start = (currentPageIndex - 1) * itemsPerPage + 1
	local ending = math.min(currentPageIndex * itemsPerPage, #searchResults)

	for i = start, ending do
		local bundle = searchResults[i]
		if not bundle then break end

		local box = Instance.new("ViewportFrame", gridScroller)
		box.BackgroundColor3 = C.panel
		box.BackgroundTransparency = 0.3
		stroke(box, C.surfaceHi, 1)

		local label = Instance.new("TextLabel", box)
		label.Size = UDim2.new(1, 0, 0, s(16))
		label.Position = UDim2.new(0, 0, 1, -s(16))
		label.BackgroundColor3 = C.overlay
		label.BackgroundTransparency = 0.4
		label.Text = truncate(bundle.Name, 11)
		label.TextColor3 = C.text
		label.Font = Enum.Font.GothamBold
		label.TextSize = s(8)
		label.ZIndex = 3

		local hitBtn = Instance.new("TextButton", box)
		hitBtn.Size = UDim2.new(1, 0, 1, 0)
		hitBtn.BackgroundTransparency = 1
		hitBtn.Text = ""
		hitBtn.ZIndex = 4

		hitBtn.MouseEnter:Connect(function() box.BackgroundColor3 = C.surfaceHi end)
		hitBtn.MouseLeave:Connect(function() box.BackgroundColor3 = C.panel end)

		hitBtn.MouseButton1Click:Connect(function()
			inspectBundleDetails(bundle.Id, bundle.Name)
		end)

		local dummy, animator, conn = buildViewportSkeleton(box)

		local loopThread = task.spawn(function()
			-- Skip loading process if user answered "No" for this bundle
			if skippedBundles[tostring(bundle.Id)] then
				return 
			end

			local ok, details = pcall(function() return as:GetBundleDetailsAsync(bundle.Id) end)
			if not ok or not details or not details.Items then return end
			local usableTracks = {}
			for _, subItem in ipairs(details.Items) do
				if m[string.lower(subItem.AssetType or "")] then
					table.insert(usableTracks, subItem)
				end
			end
			if #usableTracks == 0 then return end
			local trackIndex = 1
			local activeCellTrack = nil
			while box and box.Parent do
				local subItem = usableTracks[trackIndex]
				local animAssets = get(subItem.Id, bundle.Id)
				if #animAssets > 0 then
					if activeCellTrack then activeCellTrack:Stop() end
					activeCellTrack = animator:LoadAnimation(animAssets[1])
					activeCellTrack.Looped = true
					activeCellTrack:Play()
				end
				task.wait(3.0)
				trackIndex = trackIndex + 1
				if trackIndex > #usableTracks then trackIndex = 1 end
			end
		end)

		table.insert(activeGridThreads, loopThread)
		box.Destroying:Connect(function()
			task.cancel(loopThread)
			conn:Disconnect()
		end)
	end

	gridScroller.CanvasSize = UDim2.new(0, 0, 0, gridLayout.AbsoluteContentSize.Y + s(12))
	pageLbl.Text = "Page " .. tostring(currentPageIndex)
	prevBtn.BackgroundTransparency = (currentPageIndex > 1) and 0.4 or 0.65
	prevBtn.TextColor3 = (currentPageIndex > 1) and C.text or C.textMuted
end

local function checkAndDrawGrid(pageData)
	local newCount = 0
	local currentNew = {}
	for _, b in ipairs(pageData) do
		if not seenBundles[tostring(b.Id)] then
			newCount = newCount + 1
			table.insert(currentNew, b)
		end
	end

	if newCount > 0 then
		showDialog(newCount, function(loadNew)
			for _, b in ipairs(currentNew) do
				local bIdStr = tostring(b.Id)
				seenBundles[bIdStr] = true
				if not loadNew then
					skippedBundles[bIdStr] = true
				end
			end
			saveSeenBundles()
			drawGridPage()
		end)
	else
		drawGridPage()
	end
end

local function executeDiscoverySearch(query)
	searchResults = {}
	currentPageIndex = 1
	catalogCursor = nil
	loadingOverlay.Visible = true
	pageLbl.Text = "Loading…"

	local p = CatalogSearchParams.new()
	p.SearchKeyword = query or ""
	p.BundleTypes = {Enum.BundleType.Animations}
	p.IncludeOffSale = true
	p.Limit= 120
	pcall(function() p.CreatorType = Enum.CreatorType.User end)
	pcall(function() p.SalesTypeFilter = Enum.SalesTypeFilter.All end)
	pcall(function() p.SortType = Enum.CatalogSortType.RecentlyCreated end)

	local ok, pages = pcall(function() return aes:SearchCatalog(p) end)
	if ok and pages then
		catalogCursor = pages
		searchResults = pages:GetCurrentPage()
		checkAndDrawGrid(searchResults)
	else
		pageLbl.Text = "Error"
		loadingOverlay.Text = "Search Error"
	end
end

