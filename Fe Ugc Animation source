-- 1. Load Anims Cache (guarded: file may not exist on first run, that's fine)
local loadSuccess, fileContent = pcall(function()
	if isfile and not isfile(CACHE_FILE_NAME) then return nil end
	return readfile(CACHE_FILE_NAME)
end)
if loadSuccess and fileContent then
	pcall(function() fileCache = hs:JSONDecode(fileContent) end)
end

task.spawn(function()
	local ok, onlineContent = pcall(function() return game:HttpGet(ANIM_CACHE_URL) end)
	if ok and onlineContent then
		pcall(function()
			local onlineData = hs:JSONDecode(onlineContent)
			for k, v in pairs(onlineData) do
				if not fileCache[k] then fileCache[k] = v end
			end
			writefile(CACHE_FILE_NAME, hs:JSONEncode(fileCache))
		end)
	end
end)

local function saveCacheToFile()
	pcall(function() writefile(CACHE_FILE_NAME, hs:JSONEncode(fileCache)) end)
end

-- 2. Load Seen Bundles Cache (guarded)
pcall(function()
	if isfile and not isfile(SEEN_BUNDLES_FILE) then return end
	local content = readfile(SEEN_BUNDLES_FILE)
	if content then seenBundles = hs:JSONDecode(content) end
end)

task.spawn(function()
	local ok, onlineContent = pcall(function() return game:HttpGet(SEEN_CACHE_URL) end)
	if ok and onlineContent then
		pcall(function()
			local onlineData = hs:JSONDecode(onlineContent)
			for k, v in pairs(onlineData) do
				if seenBundles[k] == nil then seenBundles[k] = v end
			end
			writefile(SEEN_BUNDLES_FILE, hs:JSONEncode(seenBundles))
		end)
	end
end)

local function saveSeenBundles()
	pcall(function() writefile(SEEN_BUNDLES_FILE, hs:JSONEncode(seenBundles)) end)
end

-- 3. Load Equipped Anims Cache ONCE at script start (guarded against missing file).
-- After this point, `equippedAnims` is the single in-memory source of truth.
-- Respawns (applySavedAnimations) and re-equips only ever read/write this table,
-- never touching disk again except via saveEquippedAnims() when the user changes something.
pcall(function()
	if isfile and not isfile(EQUIPPED_FILE) then return end
	local content = readfile(EQUIPPED_FILE)
	if content then equippedAnims = hs:JSONDecode(content) end
end)

local function saveEquippedAnims()
	pcall(function() writefile(EQUIPPED_FILE, hs:JSONEncode(equippedAnims)) end)
end

-- Function to handle fetching assets
local function get(id, bundleId)
	local stringId = tostring(id)
	local cleanBundleId = tostring(bundleId or "Unknown")
	if assetCache[stringId] then return assetCache[stringId] end
	if fileCache[stringId] then
		local reconstructed = {}
		for _, data in ipairs(fileCache[stringId]) do
			local anim = Instance.new("Animation")
			anim.Name = data.Name
			anim.AnimationId = data.AnimationId
			table.insert(reconstructed, anim)
		end
		assetCache[stringId] = reconstructed
		return reconstructed
	end
	local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. stringId) end)
	local t = {}
	local serializableData = {}
	if ok and objs and #objs > 0 then
		local r = objs[1]
		local function processItem(item)
			if item:IsA("Animation") then
				table.insert(t, item)
				table.insert(serializableData, { Name = item.Name, AnimationId = item.AnimationId, BundleId = cleanBundleId })
			end
		end
		processItem(r)
		for _, c in ipairs(r:GetDescendants()) do processItem(c) end
	end
	assetCache[stringId] = t
	fileCache[stringId] = serializableData
	saveCacheToFile()
	return t
end

-- Returns true if an asset id has NOT yet been fetched/cached anywhere
-- (i.e. loading it would require a live GetObjects call and could lag).
local function isUncached(id)
	local stringId = tostring(id)
	return not assetCache[stringId] and not fileCache[stringId]
end

-- Wipes a bad/stale asset id from both the in-memory and on-disk caches so the
-- next get() call is forced to re-fetch it fresh via GetObjects instead of
-- returning the same broken/empty data again.
local function clearAssetCache(id)
	local stringId = tostring(id)
	assetCache[stringId] = nil
	fileCache[stringId] = nil
	saveCacheToFile()
end

