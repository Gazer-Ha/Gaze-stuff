local function buildViewportSkeleton(viewportFrame)
	local worldModel = viewportFrame:FindFirstChildOfClass("WorldModel")
	if not worldModel then
		worldModel = Instance.new("WorldModel")
		worldModel.Parent = viewportFrame
	else
		for _, child in ipairs(worldModel:GetChildren()) do child:Destroy() end
	end
	local char = lp.Character or lp.CharacterAdded:Wait()
	char.Archivable = true
	local clone = char:Clone()
	clone.Parent = worldModel
	local root = clone:WaitForChild("HumanoidRootPart")
	local human = clone:FindFirstChildOfClass("Humanoid")
	local anim = human:FindFirstChildOfClass("Animator") or Instance.new("Animator", human)
	local animateScript = clone:FindFirstChild("Animate")
	if animateScript then animateScript.Disabled = true end
	local cam = viewportFrame:FindFirstChildOfClass("Camera")
	if not cam then
		cam = Instance.new("Camera")
		cam.Parent = viewportFrame
		viewportFrame.CurrentCamera = cam
	end
	cam.CFrame = CFrame.new(Vector3.new(0, 1.5, 6), Vector3.new(0, 0, 0))
	local angle = 0
	local conn = rs.RenderStepped:Connect(function(dt)
		if clone and root then
			angle = angle + math.rad(25 * dt)
			clone:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, angle, 0))
		end
	end)
	return clone, anim, conn
end

local function applyAnimationToCharacter(character, targetAnimations, slotType)
	local animate = character:WaitForChild("Animate", 5)
	local human = character:FindFirstChildOfClass("Humanoid")
	if not animate or not human then return end

	for _, track in ipairs(human:GetPlayingAnimationTracks()) do
		pcall(function() track:AdjustWeight(0, 0) track:Stop(0) end)
	end
	
	animate.Disabled = true
	local cleanSlot = string.lower(slotType or "")
	local animateFolderId = m[cleanSlot]
	
	if animateFolderId then
		-- Apply to character
		local folder = animate:FindFirstChild(animateFolderId)
		if folder then
			for _, obj in ipairs(folder:GetChildren()) do
				if obj:IsA("Animation") then obj:Destroy() end
			end
			
			-- Prepare data for saving (in-memory table; disk write happens in saveEquippedAnims)
			equippedAnims[cleanSlot] = {}
			
			for _, animAsset in ipairs(targetAnimations) do
				local newAnim = Instance.new("Animation")
				newAnim.Name = animAsset.Name
				newAnim.AnimationId = animAsset.AnimationId
				newAnim.Parent = folder
				
				table.insert(equippedAnims[cleanSlot], {
					Name = animAsset.Name,
					AnimationId = animAsset.AnimationId
				})
			end
			
			saveEquippedAnims()
		end
	end
	
	task.wait(0.05)
	animate.Disabled = false

	-- Animate's own init logic re-asserts default run/walk/jump/climb animation ids
	-- right after being re-enabled, silently overwriting what we just set. Reassert
	-- ours on top a moment later to win that race (idle/fall aren't affected the
	-- same way so they don't need this).
	if animateFolderId then
		task.delay(0.15, function()
			if character and character.Parent then
				local folder = animate:FindFirstChild(animateFolderId)
				if folder then
					for _, obj in ipairs(folder:GetChildren()) do
						if obj:IsA("Animation") then obj:Destroy() end
					end
					for _, data in ipairs(equippedAnims[cleanSlot] or {}) do
						local newAnim = Instance.new("Animation")
						newAnim.Name = data.Name
						newAnim.AnimationId = data.AnimationId
						newAnim.Parent = folder
					end
				end
			end
		end)
	end
end

-- Function to re-apply saved animations automatically.
-- This ONLY reads the in-memory `equippedAnims` table (loaded once at script start).
-- No readfile call happens here, so respawns are instant and never risk a file-read error.
--
-- IMPORTANT: Roblox's default Animate LocalScript re-asserts its own default
-- animation ids into the run/walk/jump/climb folders as part of its own init
-- logic right after it's enabled, which silently overwrites what we just set.
-- idle/fall aren't touched as aggressively so they "just work". To beat this,
-- we write our animations, re-enable Animate, then wait a moment for its init
-- to finish and immediately write our animations back in on top of it again.
local function pushEquippedAnimsIntoFolders(animate)
	for slot, animDataList in pairs(equippedAnims) do
		local folderName = m[slot]
		if folderName then
			local folder = animate:FindFirstChild(folderName)
			if folder then
				for _, obj in ipairs(folder:GetChildren()) do
					if obj:IsA("Animation") then obj:Destroy() end
				end
				for _, data in ipairs(animDataList) do
					local newAnim = Instance.new("Animation")
					newAnim.Name = data.Name
					newAnim.AnimationId = data.AnimationId
					newAnim.Parent = folder
				end
			end
		end
	end
end

local function applySavedAnimations(character)
	local animate = character:WaitForChild("Animate", 5)
	local human = character:WaitForChild("Humanoid", 5)
	if not animate or not human then return end
	
	-- Check if we have anything saved
	local hasSavedAnims = false
	for _, _ in pairs(equippedAnims) do hasSavedAnims = true; break end
	if not hasSavedAnims then return end

	for _, track in ipairs(human:GetPlayingAnimationTracks()) do
		pcall(function() track:AdjustWeight(0, 0) track:Stop(0) end)
	end
	
	animate.Disabled = true
	pushEquippedAnimsIntoFolders(animate)
	task.wait(0.05)
	animate.Disabled = false

	-- Animate's own init (run/walk/jump/climb defaults) kicks in right as it's
	-- re-enabled, so reassert ours on top a moment later to win that race.
	task.delay(0.15, function()
		if character and character.Parent then
			pushEquippedAnimsIntoFolders(animate)
		end
	end)
	-- One more pass slightly later in case CharacterAdded-driven default-loading
	-- (which can fire on its own short delay) tries again.
	task.delay(0.6, function()
		if character and character.Parent then
			pushEquippedAnimsIntoFolders(animate)
		end
	end)
end

-- Bind Respawn handling
lp.CharacterAdded:Connect(function(char)
	task.spawn(applySavedAnimations, char)
end)

local function getSpecificTrack(fetchedTracks, targetType)
	if #fetchedTracks == 0 then return nil end
	local fallbackTrack = fetchedTracks[1]
	if targetType == "swimidleanimation" then
		for _, tr in ipairs(fetchedTracks) do
			if string.lower(tr.Name):find("idle") then return tr end
		end
		if fetchedTracks[2] then return fetchedTracks[2] end
	elseif targetType == "swimanimation" then
		for _, tr in ipairs(fetchedTracks) do
			if string.lower(tr.Name) == "swim" then return tr end
		end
	end
	return fallbackTrack
end

local function truncate(str, maxLen)
	if #str > maxLen then return str:sub(1, maxLen - 1) .. "…" end
	return str
end

-- Tries to load+play a single track on the given animator. Returns true on success.
-- "Success" means LoadAnimation didn't error AND the track actually reports as
-- playing shortly after Play() is called (catches silently-dead/broken animations,
-- not just hard Lua errors).
local function tryPlayTrack(animator, track, looped)
	local ok, playedTrack = pcall(function()
		local tr = animator:LoadAnimation(track)
		tr.Looped = looped
		tr:Play()
		return tr
	end)
	if not ok or not playedTrack then return false, nil end
	task.wait(0.15)
	if not playedTrack.IsPlaying then
		pcall(function() playedTrack:Stop() end)
		return false, nil
	end
	return true, playedTrack
end

local masterRenderGen = 0 -- incremented on every renderMasterTrack call; lets stale retry loops know to stop

local function renderMasterTrack(itemPayload, assetTypeName)
	if activeMasterTrack then activeMasterTrack:Stop() activeMasterTrack = nil end
	masterRenderGen = masterRenderGen + 1
	local myGen = masterRenderGen
	local dummy, animator, _ = buildViewportSkeleton(masterViewport)
	local lowerType = string.lower(assetTypeName or "")
	local displayType = shortNames[lowerType] or "Track"

	-- Keeps clearing the cache and re-fetching until it gets usable tracks + a
	-- matching track for this slot, or until superseded by a newer click.
	-- Short backoff between attempts so it doesn't hammer GetObjects.
	local function fetchWithReload()
		local attempt = 0
		while myGen == masterRenderGen do
			local fetchedTracks = get(itemPayload.Id)
			local trackToPlay = (#fetchedTracks > 0) and getSpecificTrack(fetchedTracks, lowerType) or nil
			if #fetchedTracks > 0 and trackToPlay then
				return fetchedTracks, trackToPlay
			end
			attempt = attempt + 1
			statusLabel.Text = truncate(activeBundleName, 22) .. "  •  " .. displayType .. " (reloading… " .. attempt .. ")"
			clearAssetCache(itemPayload.Id)
			task.wait(math.min(0.5 + attempt * 0.3, 3))
		end
		return nil, nil -- superseded by a newer click, bail out quietly
	end

	statusLabel.Text = truncate(activeBundleName, 22) .. "  •  " .. displayType .. " (loading…)"
	task.spawn(function()
		local fetchedTracks, trackToPlay = fetchWithReload()
		if myGen ~= masterRenderGen then return end -- superseded while we were fetching
		if not fetchedTracks or not trackToPlay then return end

		activeMasterAnimName = itemPayload.Name
		activeMasterType = assetTypeName
		statusLabel.Text = truncate(activeBundleName, 22) .. "  •  " .. displayType

		local isIdle = (lowerType == "idleanimation")
		if isIdle and #fetchedTracks > 1 then
			local pointer = 1
			while myGen == masterRenderGen and dummy and dummy.Parent do
				if activeMasterTrack then activeMasterTrack:Stop() end
				local track = fetchedTracks[pointer]
				local ok, playedTrack = tryPlayTrack(animator, track, false)
				while not ok and myGen == masterRenderGen do
					-- This individual clip is dead/unselectable: keep clearing + re-fetching
					-- until it plays or the user moves on to something else.
					clearAssetCache(itemPayload.Id)
					local reloaded = get(itemPayload.Id)
					if #reloaded > 0 then fetchedTracks = reloaded end
					if pointer > #fetchedTracks then pointer = 1 end
					track = fetchedTracks[pointer]
					task.wait(0.4)
					ok, playedTrack = tryPlayTrack(animator, track, false)
				end
				if myGen ~= masterRenderGen then return end
				activeMasterTrack = playedTrack
				activeMasterTrack.Stopped:Wait()
				pointer = pointer + 1
				if pointer > #fetchedTracks then pointer = 1 end
			end
		else
			local ok, playedTrack = tryPlayTrack(animator, trackToPlay, true)
			while not ok and myGen == masterRenderGen do
				-- Doesn't play / can't be selected: keep clearing cache and reloading
				-- until it works or the user clicks a different slot/bundle.
				statusLabel.Text = truncate(activeBundleName, 22) .. "  •  " .. displayType .. " (reloading…)"
				clearAssetCache(itemPayload.Id)
				task.wait(0.4)
				local reloaded = get(itemPayload.Id)
				local reloadedTrack = (#reloaded > 0) and getSpecificTrack(reloaded, lowerType) or nil
				if #reloaded > 0 and reloadedTrack then
					trackToPlay = reloadedTrack
					ok, playedTrack = tryPlayTrack(animator, trackToPlay, true)
				end
			end
			if myGen ~= masterRenderGen then return end
			statusLabel.Text = truncate(activeBundleName, 22) .. "  •  " .. displayType
			activeMasterTrack = playedTrack
		end
	end)
end

