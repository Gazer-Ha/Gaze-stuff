-- Actually does the fetch + populate work for a bundle's details.
-- Split out from inspectBundleDetails so it can be deferred behind the lag-warning dialog.
local function loadBundleDetailsNow(bundleId, bundleName)
	local ok, res = pcall(function() return as:GetBundleDetailsAsync(bundleId) end)
	if not ok or not res or not res.Items then
		statusLabel.Text = truncate(activeBundleName, 22) .. "  •  Error"
		return
	end

	targetBundleItems = res.Items
	wearAllBtn.Visible = true

	for _, item in ipairs(res.Items) do
		local lowerType = string.lower(item.AssetType or "")
		if lowerType == "swimanimation" then
			currentBundleItems["swimanimation"] = item
			currentBundleItems["swimidleanimation"] = item
			for _, tt in ipairs({"swimanimation", "swimidleanimation"}) do
				local b = animationButtons[tt]
				if b then b.BackgroundColor3 = C.green b.TextColor3 = C.text end
			end
		elseif shortNames[lowerType] then
			currentBundleItems[lowerType] = item
			local b = animationButtons[lowerType]
			if b then b.BackgroundColor3 = C.green b.TextColor3 = C.text end
		end
	end

	if currentBundleItems["idleanimation"] then
		wearSelectedBtn.Visible = true
		renderMasterTrack(currentBundleItems["idleanimation"], "IdleAnimation")
	else
		statusLabel.Text = truncate(activeBundleName, 22) .. "  •  No Idle"
	end
end

local function inspectBundleDetails(bundleId, bundleName)
	table.clear(currentBundleItems)
	wearSelectedBtn.Visible = false
	wearAllBtn.Visible = false
	activeBundleName = bundleName or "Unknown"
	statusLabel.Text = truncate(activeBundleName, 22) .. "  •  Loading…"

	for _, btn in pairs(animationButtons) do
		btn.BackgroundColor3 = C.surfaceHi
		btn.TextColor3 = C.textMuted
	end

	-- Peek at the bundle's items first (cheap metadata call) so we can tell whether
	-- any of its animation slots (run, walk, etc.) have never been fetched before.
	-- Fetching a brand-new one is what actually causes the lag, so only ask about that.
	local peekOk, peekRes = pcall(function() return as:GetBundleDetailsAsync(bundleId) end)
	if not peekOk or not peekRes or not peekRes.Items then
		statusLabel.Text = truncate(activeBundleName, 22) .. "  •  Error"
		return
	end

	local uncachedTypeNames = {}
	for _, item in ipairs(peekRes.Items) do
		local lowerType = string.lower(item.AssetType or "")
		if m[lowerType] and isUncached(item.Id) then
			table.insert(uncachedTypeNames, shortNames[lowerType] or lowerType)
		end
	end

	if #uncachedTypeNames > 0 then
		statusLabel.Text = truncate(activeBundleName, 22) .. "  •  Waiting…"
		showUncachedSlotDialog(uncachedTypeNames, function(loadNew)
			if loadNew then
				statusLabel.Text = truncate(activeBundleName, 22) .. "  •  Loading…"
				loadBundleDetailsNow(bundleId, bundleName)
			else
				statusLabel.Text = truncate(activeBundleName, 22) .. "  •  Skipped"
			end
		end)
	else
		-- Everything needed is already cached, no lag risk, just load straight away.
		loadBundleDetailsNow(bundleId, bundleName)
	end
end

