nextBtn.MouseButton1Click:Connect(function()
	if (currentPageIndex * itemsPerPage < #searchResults) then
		currentPageIndex = currentPageIndex + 1
		loadingOverlay.Visible = true
		drawGridPage()
	elseif catalogCursor and not catalogCursor.IsFinished then
		loadingOverlay.Visible = true
		pageLbl.Text = "Loading…"
		local ok, _ = pcall(function() catalogCursor:AdvanceToNextPageAsync() end)
		if ok then
			local nextChunk = catalogCursor:GetCurrentPage()
			for _, v in ipairs(nextChunk) do table.insert(searchResults, v) end
			currentPageIndex = currentPageIndex + 1
			checkAndDrawGrid(nextChunk)
		end
	end
end)

prevBtn.MouseButton1Click:Connect(function()
	if currentPageIndex > 1 then
		currentPageIndex = currentPageIndex - 1
		loadingOverlay.Visible = true
		drawGridPage()
	end
